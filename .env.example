# ==============================================================================
# SHAGUN ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, and Storage metadata)
# https://supabase.com/dashboard
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Google OAuth & Google Drive API (drive.file scope ONLY)
# https://console.cloud.google.com/apis/credentials
# Ensure 'Google Drive API' is enabled and 'drive.file' scope is approved
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 32-byte secret key used for AES-256-GCM encryption of OAuth refresh tokens at rest
TOKEN_ENCRYPTION_KEY=super-secret-32-char-minimum-key-for-tokens!

# ------------------------------------------------------------------------------
# 3. Platform Activation UPI (Platform Owner Scanner QR)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_UPI_ID=shagun.pass@okhdfcbank

# ------------------------------------------------------------------------------
# 3. Razorpay Payments (UPI Intent, QR, and Webhooks)
# https://dashboard.razorpay.com/app/keys
# Use Test Key for development (rzp_test_...)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

